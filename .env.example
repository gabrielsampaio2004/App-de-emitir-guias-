# Banco — Postgres. A URL fica aqui e é lida pelo prisma.config.ts.
# Não coloque url no schema.prisma: o Prisma 7 proíbe (erro P1012).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/guiazap"

# Fila
REDIS_URL="redis://localhost:6379"

# Criptografia do accessToken da Meta guardado no banco (AES-256-GCM).
# Precisa ser real mesmo em desenvolvimento — 32 bytes em hex.
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=""

# Storage (Cloudflare R2 — compatível com S3).
# Guarda os PDFs das guias, e SÓ isso. Nenhum token vai para o R2: o
# accessToken da Meta fica cifrado no Postgres (ver WHATSAPP_ACCESS_TOKEN
# mais abaixo). Lido por src/lib/storage.ts.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="guiazap-docs"

# --- WhatsApp Cloud API ---

# Token verificador do webhook — você inventa esta string e repete no painel
# da Meta. Usado pelo GET de /api/webhooks/whatsapp.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# App Secret da Meta, usado para validar a assinatura X-Hub-Signature-256
# no POST de /api/webhooks/whatsapp.
WHATSAPP_APP_SECRET=""

# Credenciais da conta WhatsApp do tenant. Lidas SÓ pelo prisma/seed.ts, que
# grava no banco — o accessToken vai cifrado com ENCRYPTION_KEY (AES-256-GCM)
# na coluna WhatsAppAccount.accessTokenEnc, nunca em texto puro.
# Sem elas o seed grava placeholders e avisa; o envio real falha até você
# preencher e rodar `npm run db:seed` de novo.
WHATSAPP_WABA_ID=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_DISPLAY_PHONE="+55 79 9999-9999"

# Telefone do cliente de demonstração criado pelo seed, em E.164.
SEED_CLIENT_PHONE="+5511999999999"

# --- Ainda não usadas em código ---

# Auth (better-auth ainda não está ligado; as actions gravam actorLabel
# "system:web" no lugar do usuário logado)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

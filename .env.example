# Banco — Postgres. A URL fica aqui e é lida pelo prisma.config.ts.
# Não coloque url no schema.prisma: o Prisma 7 proíbe (erro P1012).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/guiazap"

# Fila
REDIS_URL="redis://localhost:6379"

# Criptografia do accessToken da Meta guardado no banco (AES-256-GCM).
# Precisa ser real mesmo em desenvolvimento — 32 bytes em hex.
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=""

# Storage (Cloudflare R2 — compatível com S3).
# Guarda os PDFs das guias, e SÓ isso. Nenhum token vai para o R2: o
# accessToken da Meta fica cifrado no Postgres (ver WHATSAPP_ACCESS_TOKEN
# mais abaixo). Lido por src/lib/storage.ts.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="guiazap-docs"

# --- WhatsApp Cloud API ---

# Token verificador do webhook — você inventa esta string e repete no painel
# da Meta. Usado pelo GET de /api/webhooks/whatsapp.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# App Secret da Meta, usado para validar a assinatura X-Hub-Signature-256
# no POST de /api/webhooks/whatsapp.
WHATSAPP_APP_SECRET=""

# Credenciais da conta WhatsApp do tenant. Lidas SÓ pelo prisma/seed.ts, que
# grava no banco — o accessToken vai cifrado com ENCRYPTION_KEY (AES-256-GCM)
# na coluna WhatsAppAccount.accessTokenEnc, nunca em texto puro.
# Sem elas o seed grava placeholders e avisa; o envio real falha até você
# preencher e rodar `npm run db:seed` de novo.
WHATSAPP_WABA_ID=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_DISPLAY_PHONE="+55 79 9999-9999"

# Nome do template aprovado no painel da Meta (categoria UTILITY, header
# DOCUMENT — a categoria se escolhe lá, não aqui). Opcional: vazia cai no
# default "envio_guia_fiscal". Diferente das variáveis acima, esta é lida
# direto pelo dispatcher (src/workers/dispatcher.ts), não pelo seed — dá
# pra trocar sem rodar `npm run db:seed` de novo. Útil pra testar a conexão
# com a Meta com um template já aprovado antes de "envio_guia_fiscal" passar
# pela aprovação.
WHATSAPP_TEMPLATE_NAME=""

# Telefone do cliente de demonstração criado pelo seed, em E.164.
SEED_CLIENT_PHONE="+5511999999999"

# --- Auth (better-auth, Etapa B) ---

# Gere com: openssl rand -hex 32. Assina cookie de sessão — trocar depois de
# ir para produção invalida toda sessão ativa (aceitável; senha continua
# valendo, só desloga todo mundo).
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Bootstrap do primeiro OWNER, lido só pelo prisma/seed.ts. Cadastro público
# está desligado de propósito (emailAndPassword.disableSignUp) — sem essas
# três variáveis na primeira vez que o seed roda, ninguém entra no sistema.
# Não sobrescreve senha de usuário já existente com o mesmo e-mail; depois
# do primeiro OWNER, crie os demais usuários pela tela /usuarios.
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
SEED_OWNER_NAME=""
